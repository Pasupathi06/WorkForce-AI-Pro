          departmentAPI.list({ include_inactive: false }),
        ])

      let employeeCount = null
      let highRiskPredictions = null
      let departmentRecords = []
      const issues = []

      if (countResult.status === 'fulfilled') {
        const count = Number(countResult.value?.count)
        if (Number.isFinite(count) && count >= 0) {
          employeeCount = count
        } else {
          issues.push('Employee count returned an invalid response.')
        }
      } else {
        issues.push('Employee count could not be loaded.')
      }

      if (historyResult.status === 'fulfilled') {
        const total = Number(historyResult.value?.total)
        if (Number.isFinite(total) && total >= 0) {
          highRiskPredictions = total
        } else {
          issues.push('High-risk prediction history returned an invalid response.')
        }
      } else {
        issues.push('High-risk prediction history could not be loaded.')
      }

      if (departmentResult.status === 'fulfilled') {
        departmentRecords = normalizeList(departmentResult.value)
      } else {
        issues.push('Department list could not be loaded.')
      }

      const departmentsWithCounts = await Promise.all(
        departmentRecords.map(async (department, index) => {
          const color = departmentColors[index % departmentColors.length]

          try {
            const response = await employeeAPI.count({
              department_id: department.id,
              active_only: true,
            })
            const count = Number(response?.count)

            if (!Number.isFinite(count) || count < 0) {
              issues.push(
                `Employee count is invalid for ${department.name || 'a department'}.`
              )
              return {
                id: department.id,
                name: department.name || 'Unnamed department',
                value: null,
                color,
              }
            }

            return {
              id: department.id,
              name: department.name || 'Unnamed department',
              value: count,
              color,
            }
          } catch {
            issues.push(
              `Employee count could not be loaded for ${department.name || 'a department'}.`
            )
            return {
              id: department.id,
              name: department.name || 'Unnamed department',
              value: null,
              color,
            }
          }
        })
      )

      setDashboardData({
        loading: false,
        error: issues.length > 0 ? issues.join(' ') : '',
        employeeCount,
        highRiskPredictions,
        departments: departmentsWithCounts,
      })
    } catch (error) {
      setDashboardData((current) => ({
        ...current,
        loading: false,
        error: getErrorMessage(error) || 'Unable to load dashboard data.',
