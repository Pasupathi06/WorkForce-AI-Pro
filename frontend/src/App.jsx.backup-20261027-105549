                      historyItems.map((item) => {
                        const level = String(item.risk_level || '').toUpperCase()
                        const levelClass = ['LOW', 'MEDIUM', 'HIGH'].includes(level)
                          ? `risk-${level.toLowerCase()}`
                          : ''

                        return (
                          <tr key={item.id}>
                            <td>
                              {(() => {
                                if (!item.created_at) return 'Date unavailable'

                                const parsedDate = new Date(item.created_at)

                                return Number.isNaN(parsedDate.getTime())
                                  ? 'Invalid date'
                                  : parsedDate.toLocaleString()
                              })()}
                            </td>
                            <td>{item.employee_id ?? 'General prediction'}</td>
                            <td>
                              <span className={`risk-badge ${levelClass}`}>
                                {level || 'UNKNOWN'}
                              </span>
                            </td>
                            <td>
                              {Number(item.attrition_risk_percentage ?? 0).toFixed(1)}%
                            </td>
                            <td>{item.model_type || '?'}</td>
                            <td>{item.predicted_by_name || `User #${item.predicted_by_user_id ?? '?'}`}</td>
                          </tr>
                        )
                      })
                    )}
                  </tbody>
                </table>
              </div>

              <div className="history-pagination">
