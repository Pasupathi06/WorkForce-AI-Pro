function MetricCard({ label, value, change, positive, icon: Icon, tone, detail }) {
  return (
    <article className="metric-card">
      <div className="metric-top">
        <span>{label}</span>
        <div className={`metric-icon ${tone}`}>
          <Icon size={20} strokeWidth={1.8} />
        </div>
      </div>

      <div className="metric-value">{value}</div>

      <div className="metric-bottom">
        <span className={`metric-change ${positive ? 'positive' : 'negative'}`}>
          {positive ? <ArrowUpRight size={14} /> : <ArrowDownRight size={14} />}
          {change}
        </span>
        <span>{detail}</span>
      </div>
    </article>
  )
}

function EmployeeTable({ employees }) {
  if (!employees.length) {
    return <div className="empty-state">No employee records found.</div>
  }

  return (
    <div className="table-scroll">
      <table className="employee-table">
        <thead>
          <tr>
            <th>EMPLOYEE</th>
            <th>DEPARTMENT</th>
            <th>ATTRITION RISK</th>
            <th>RISK SCORE</th>
            <th>STATUS</th>
          </tr>
        </thead>

        <tbody>
          {employees.map((employee, index) => {
            const isDemo = Boolean(employee.demo)
            const employeeName = isDemo
              ? employee.name
              : employee.name || employee.employee_code || `Employee #${employee.id}`

            const subtitle = isDemo
              ? employee.role
              : employee.designation || 'Designation not set'

            const initials = isDemo
              ? employee.initials || getInitials(employee.name)
              : getInitials(employee.name || employee.employee_code || `E${employee.id}`)

            return (
              <tr key={employee.id ?? `${employeeName}-${index}`}>
                <td>
                  <div className="employee-identity">
                    <div className={`employee-avatar ${employee.color || 'purple'}`}>
                      {initials}
                    </div>

                    <div>
                      <strong>{employeeName}</strong>
                      <small>
                        {isDemo
                          ? subtitle
                          : `${subtitle} Â· User ID ${employee.user_id}`}
                      </small>
                      {!isDemo && employee.email && (
                        <small>{employee.email}</small>
                      )}
                    </div>
                  </div>
                </td>

                <td>
                  {isDemo
                    ? employee.department || 'Not assigned'
                    : employee.department_name || (
                        employee.department_id
                          ? `Department #${employee.department_id}`
                          : 'Not assigned'
                      )}
                </td>

                <td>
                  {employee.risk && employee.risk !== 'Not calculated' ? (
                    <span className={`risk-badge ${String(employee.risk).toLowerCase()}`}>
                      <i />
                      {employee.risk}
                    </span>
                  ) : (
                    <span className="risk-badge">Not calculated</span>
                  )}
                </td>

                <td>
                  {Number.isFinite(employee.score) ? (
                    <div className="score-cell">
                      <div className="score-track">
                        <span
                          className={String(employee.risk || 'Low').toLowerCase()}
                          style={{
                            width: `${Math.max(0, Math.min(100, employee.score))}%`,
                          }}
                        />
                      </div>
                      <strong>{employee.score}%</strong>
                    </div>
                  ) : (
                    '—'
                  )}
                </td>

                <td>
                  <span className="active-status">
                    <i />
                    {isDemo
                      ? 'Demo'
                      : employee.is_active
                        ? 'Active'
                        : 'Inactive'}
                  </span>
                </td>
              </tr>
            )
          })}
        </tbody>
      </table>
    </div>
  )
}
export default App






































