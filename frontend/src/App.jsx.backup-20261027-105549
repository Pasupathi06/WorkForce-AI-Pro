                    className="subtle-button"
                    disabled={
                      historyLoading ||
                      historyPage >= Math.max(1, Math.ceil(historyTotal / historyPageSize))
                    }
                    onClick={() => void loadAttritionHistory(historyPage + 1)}
                  >
                    Next
                  </button>
                </div>
              </div>
            </section>
          )}

