  async function loadAttritionHistory(page = historyPage, filterOverrides = {}) {
    if (!canManage) return

    setHistoryLoading(true)
    setHistoryError('')

    const params = {
      page,
      page_size: historyPageSize,
    }

    const riskFilter = filterOverrides.risk ?? historyRiskFilter
    const startDateFilter = filterOverrides.startDate ?? historyStartDateFilter
    const endDateFilter = filterOverrides.endDate ?? historyEndDateFilter
    const modelTypeFilter = filterOverrides.modelType ?? historyModelTypeFilter
    const employeeFilterValue = filterOverrides.employee ?? historyEmployeeFilter

    if (riskFilter) params.risk_level = riskFilter
    if (startDateFilter) params.start_date = startDateFilter
    if (endDateFilter) params.end_date = endDateFilter
    if (modelTypeFilter.trim()) params.model_type = modelTypeFilter.trim()

    const employeeFilter = employeeFilterValue.trim()
    if (employeeFilter) {
      const employeeId = Number(employeeFilter)
      if (!Number.isInteger(employeeId) || employeeId <= 0) {
        setHistoryError('Employee filter must be a positive integer ID.')
        setHistoryLoading(false)
        return
      }
      params.employee_id = employeeId
    }

    const validDate = (value) => {
      if (!value) return true
      const parsed = new Date(`${value}T00:00:00`)
      return !Number.isNaN(parsed.getTime()) &&
        parsed.toISOString().slice(0, 10) === value
    }

    if (!validDate(startDateFilter) || !validDate(endDateFilter)) {
      setHistoryError('Please enter valid start and end dates.')
      setHistoryLoading(false)
      return
    }

    if (startDateFilter && endDateFilter && startDateFilter > endDateFilter) {
      setHistoryError('Start date must be on or before end date.')
      setHistoryLoading(false)
      return
    }

    try {
      const result = await attritionAPI.history(params)
      setHistoryItems(Array.isArray(result.items) ? result.items : [])
      setHistoryTotal(Number(result.total) || 0)
      setHistoryPage(Number(result.page) || page)
    } catch (error) {
      const detail = error?.response?.data?.detail
      const message = Array.isArray(detail)
        ? detail.map((item) => item.msg || JSON.stringify(item)).join('; ')
        : typeof detail === 'string'
          ? detail
          : error?.message || 'Unable to load prediction history.'

      setHistoryError(message)
    } finally {
      setHistoryLoading(false)
    }
  }

  function applyAttritionHistoryFilters() {
    setHistoryPage(1)

