async function exportAttritionHistoryCSV() {
    if (!canManage) return

    setHistoryError('')

    const params = {}
    const employeeFilter = historyEmployeeFilter.trim()
    const riskFilter = historyRiskFilter
    const startDateFilter = historyStartDateFilter
    const endDateFilter = historyEndDateFilter
    const modelTypeFilter = historyModelTypeFilter.trim()

    if (employeeFilter) {
      const employeeId = Number(employeeFilter)

      if (!Number.isInteger(employeeId) || employeeId <= 0) {
        setHistoryError('Employee filter must be a positive integer ID.')
        return
      }

      params.employee_id = employeeId
    }

    if (riskFilter) params.risk_level = riskFilter
    if (startDateFilter) params.start_date = startDateFilter
    if (endDateFilter) params.end_date = endDateFilter
    if (modelTypeFilter) params.model_type = modelTypeFilter

    const validDate = (value) => {
      if (!value) return true
      const parsed = new Date(`${value}T00:00:00`)

      return (
        !Number.isNaN(parsed.getTime()) &&
        parsed.toISOString().slice(0, 10) === value
      )
    }

    if (!validDate(startDateFilter) || !validDate(endDateFilter)) {
      setHistoryError('Please enter valid start and end dates.')
      return
    }

    if (startDateFilter && endDateFilter && startDateFilter > endDateFilter) {
      setHistoryError('Start date must be on or before end date.')
      return
    }

    setHistoryLoading(true)

    try {
      const pageSize = 100
      let page = 1
      let total = 0
      const records = []
      const maxPages = 10000

      while (page <= maxPages) {
        const result = await attritionAPI.history({
          ...params,
          page,
          page_size: pageSize,
        })

        const items = Array.isArray(result.items) ? result.items : []
        total = Number(result.total) || 0

        if (items.length === 0) break

        records.push(...items)

        if (records.length >= total || items.length < pageSize) break

        page += 1
      }

      if (page > maxPages) {
        throw new Error('Export stopped because the pagination limit was reached.')
      }

      if (records.length === 0) {
        setHistoryError('No prediction history records available to export.')
        return
      }

      const columns = [
        ['Prediction Date', 'created_at'],
        ['Employee ID', 'employee_id'],
        ['Risk Level', 'risk_level'],
        ['Attrition Probability', 'attrition_probability'],
        ['Attrition Risk Percentage', 'attrition_risk_percentage'],
        ['Model Type', 'model_type'],
        ['Predicted By', 'predicted_by_name'],
        ['Predicted By User ID', 'predicted_by_user_id'],
      ]

      const escapeCSV = (value) => {
        let text = value == null ? '' : String(value)

        if (/^[\s]*[=+\-@]/.test(text)) {
          text = "'" + text
        }

        return '"' + text.replace(/"/g, '""') + '"'
      }

      const csvRows = [
        columns.map(([label]) => escapeCSV(label)).join(','),
        ...records.map((record) =>
          columns.map(([, key]) => {
            let value = record[key]

            if (key === 'created_at' && value) {
              const parsedDate = new Date(value)
              value = Number.isNaN(parsedDate.getTime())
                ? value
                : parsedDate.toISOString()
            }

            if (key === 'employee_id' && value == null) {
              value = 'General prediction'
            }

            if (
              key === 'predicted_by_name' &&
              !value &&
              record.predicted_by_user_id != null
            ) {
              value = `User #${record.predicted_by_user_id}`
            }

            return escapeCSV(value)
          }).join(',')
        ),
      ]

      const csvContent = '\uFEFF' + csvRows.join('\r\n')
      const blob = new Blob([csvContent], {
        type: 'text/csv;charset=utf-8;',
      })

      const downloadUrl = URL.createObjectURL(blob)
      const link = document.createElement('a')

      link.href = downloadUrl
      link.download = `attrition-history-${new Date().toISOString().slice(0, 10)}.csv`

      document.body.appendChild(link)
      link.click()
      link.remove()

      setTimeout(() => URL.revokeObjectURL(downloadUrl), 1000)
    } catch (error) {
      const detail = error?.response?.data?.detail

      const message =
        typeof detail === 'string'
          ? detail
          : error?.message || 'Unable to export prediction history.'

      setHistoryError(message)
    } finally {
      setHistoryLoading(false)
    }
  }
