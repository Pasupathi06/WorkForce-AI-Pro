@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #191744;
  background: #f6f5ff;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --primary: #5c43e8;
  --primary-dark: #4530c4;
  --muted: #8585aa;
  --border: #e9e7f7;
  --green: #0aaf99;
  --red: #f04480;
  --orange: #f6a331;
  --surface: #fff;
  --shadow: 0 3px 12px rgba(45, 36, 110, .055);
}

* { box-sizing: border-box; }

html, body, #root {
  width: 100%;
  min-width: 320px;
  min-height: 100%;
  margin: 0;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 77% 4%, rgba(201, 192, 255, .32), transparent 34%),
    linear-gradient(135deg, #faf9ff, #f3f2ff 62%, #f8f7ff);
  font-size: 13px;
}

button, input, select, textarea { font: inherit; }
button { cursor: pointer; -webkit-tap-highlight-color: transparent; }
button, input { outline-offset: 3px; }
button:focus-visible, input:focus-visible { outline: 2px solid #9b8bff; }
a { color: inherit; text-decoration: none; }
svg { flex-shrink: 0; }
#root { min-height: 100vh; }

.app-shell {
  display: flex;
  width: 100%;
  min-height: 100vh;
  overflow-x: clip;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  width: 244px;
  min-width: 244px;
  height: 100dvh;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 20px 15px 16px;
  color: #fff;
  background: linear-gradient(165deg, #17153e 0%, #191741 55%, #211b55 100%);
  box-shadow: 5px 0 22px rgba(25, 20, 70, .06);
  scrollbar-width: thin;
  scrollbar-color: #51478e transparent;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 40px;
  margin: 0 0 30px;
}

.brand-mark {
  display: grid;
  width: 41px;
  height: 41px;
  flex: 0 0 41px;
  place-items: center;
  color: white;
  background: linear-gradient(140deg, #8c70ff, #5c3ce4);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 12px;
  box-shadow: 0 4px 12px rgba(102, 76, 236, .3);
}

.brand > div:last-of-type { min-width: 0; }
.brand strong {
  display: block;
  color: #fff;
  font-family: 'Manrope', sans-serif;
  font-size: 18px;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -.7px;
  white-space: nowrap;
}
.brand strong span { color: #a08cff; }
.brand small {
  display: block;
  margin-top: 4px;
  color: #b8b5df;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.25px;
  white-space: nowrap;
}
.mobile-close { display: none; }

.workspace-label, .nav-label {
  margin: 0 0 10px;
  color: #aaa7d2;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .7px;
}

.workspace-switch {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  padding: 10px;
  margin-bottom: 25px;
  background: rgba(255,255,255,.075);
  border: 1px solid rgba(255,255,255,.055);
  border-radius: 12px;
}
.workspace-avatar {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  place-items: center;
  color: #28215d;
  background: #e6e0ff;
  border-radius: 10px;
  font-size: 18px;
  font-weight: 800;
}
.workspace-switch > div:nth-child(2) { min-width: 0; flex: 1; }
.workspace-switch strong, .workspace-switch small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.workspace-switch strong { font-size: 12px; }
.workspace-switch small { margin-top: 3px; color: #b8b4db; font-size: 10px; }

.sidebar .nav-label { margin-top: 0; }
.main-nav { display: grid; gap: 5px; }

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 41px;
  padding: 0 11px;
  color: #e0def4;
  background: transparent;
  border: 0;
  border-radius: 10px;
  text-align: left;
  font-size: 12px;
  font-weight: 600;
}
.nav-item:hover { background: rgba(255,255,255,.08); color: #fff; }
.nav-item.active {
  color: #fff;
  background: linear-gradient(105deg, #6047e9, #4932b4);
  box-shadow: 0 5px 13px rgba(68, 47, 179, .23);
}
.nav-item > span:nth-child(2) { flex: 1; }
.nav-badge {
  padding: 4px 7px;
  color: #fff;
  background: #8c6cff;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 700;
}

.sidebar-bottom { margin-top: auto; padding-top: 24px; }
.sidebar-bottom > .nav-label { margin-bottom: 9px; }
.upgrade-card {
  margin-top: 20px;
  padding: 15px 13px;
  color: white;
  background: linear-gradient(145deg, #6348e8, #4430a6);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 13px;
}
.upgrade-icon {
  display: grid;
  width: 29px;
  height: 29px;
  place-items: center;
  margin-bottom: 9px;
  color: #fff;
  background: rgba(255,255,255,.12);
  border-radius: 9px;
}
.upgrade-card > strong { display: block; font-size: 12px; line-height: 1.5; }
.upgrade-card p { margin: 7px 0 12px; color: #e2dcff; font-size: 11px; line-height: 1.6; }
.upgrade-card > button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 10px;
  color: #fff;
  background: rgba(255,255,255,.18);
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 8px;
  font-size: 11px;
  font-weight: 700;
}
.upgrade-card > button:hover { background: rgba(255,255,255,.28); }

.profile-card {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
  margin-top: 17px;
  padding: 10px 8px;
  background: rgba(255,255,255,.055);
  border-radius: 11px;
}
.profile-avatar {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  place-items: center;
  color: #5944cf;
  background: linear-gradient(145deg, #f0edff, #cfc5ff);
  border: 1px solid rgba(255,255,255,.4);
  border-radius: 50%;
  font-size: 12px;
  font-weight: 800;
}
.profile-details { min-width: 0; flex: 1; }
.profile-card strong, .profile-card small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile-card strong { color: #fff; font-size: 11px; }
.profile-card small { margin-top: 3px; color: #bdb8e2; font-size: 10px; }
.profile-card .icon-button {
  width: 27px;
  height: 27px;
  color: #d9d4f6;
  background: transparent;
  border: 0;
}

.main-area {
  width: calc(100% - 244px);
  min-width: 0;
  min-height: 100vh;
  margin-left: 244px;
  flex: 1 1 auto;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
  height: 58px;
  padding: 0 27px;
  background: rgba(255,255,255,.89);
  border-bottom: 1px solid rgba(231,228,248,.85);
  backdrop-filter: blur(16px);
}
.topbar-left, .topbar-right { display: flex; align-items: center; min-width: 0; }
.topbar-left { gap: 19px; }
.breadcrumbs { color: #8987aa; font-size: 11px; white-space: nowrap; }
.breadcrumbs span { padding: 0 9px; color: #c0bdd5; }
.breadcrumbs strong { color: #211c52; font-weight: 700; }
.topbar-right { gap: 16px; }
.top-search {
  display: flex;
  align-items: center;
  gap: 9px;
  width: clamp(170px, 23vw, 310px);
  height: 36px;
  padding: 0 12px;
  color: #77759d;
  background: #fff;
  border: 1px solid #e4e1f7;
  border-radius: 20px;
}
.top-search:focus-within, .search-box:focus-within {
  border-color: #b7aaff;
  box-shadow: 0 0 0 3px rgba(112, 87, 232, .08);
}
.top-search input, .search-box input {
  width: 100%;
  min-width: 0;
  color: #27234f;
  background: transparent;
  border: 0;
  outline: none;
}
.top-search input { font-size: 11px; }
.top-search input::placeholder, .search-box input::placeholder { color: #a09db9; }

.notification-button {
  position: relative;
  display: grid;
  width: 32px;
  height: 34px;
  flex: 0 0 32px;
  place-items: center;
  color: #211b54;
  background: transparent;
  border: 0;
  border-radius: 9px;
}
.notification-button:hover { background: #f1efff; }
.notification-button > span {
  position: absolute;
  top: 5px;
  right: 5px;
  width: 7px;
  height: 7px;
  background: #ff4f86;
  border: 1px solid #fff;
  border-radius: 50%;
}
.topbar-divider { width: 1px; height: 27px; background: #e9e6f5; }
.top-profile { display: flex; align-items: center; gap: 9px; min-width: 0; }
.top-profile > div:nth-child(2) { min-width: 0; }
.top-profile strong, .top-profile small { display: block; white-space: nowrap; }
.top-profile strong { color: #25204f; font-size: 11px; }
.top-profile small { margin-top: 3px; color: #8a87a7; font-size: 10px; }
.top-profile > svg { color: #656185; }
.mobile-menu-button {
  display: none;
  width: 35px;
  height: 35px;
  place-items: center;
  color: #282054;
  background: transparent;
  border: 0;
  border-radius: 8px;
}

.page-content {
  width: 100%;
  max-width: none;
  min-width: 0;
  margin: 0;
  padding: 24px 22px 24px;
}
.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 20px;
}
.page-heading > div:first-child { min-width: 0; }
.greeting {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 7px;
  color: #6549ee;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .7px;
}
.page-heading h1 {
  margin: 0;
  color: #191642;
  font-family: 'Manrope', sans-serif;
  font-size: clamp(23px, 2.05vw, 31px);
  font-weight: 800;
  letter-spacing: -1.05px;
  line-height: 1.25;
}
.page-heading p { margin: 6px 0 0; color: #77769e; font-size: 12px; line-height: 1.5; }
.heading-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-shrink: 0; }

.primary-button, .subtle-button, .text-button, .icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 36px;
  padding: 0 12px;
  border-radius: 9px;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}
.primary-button {
  color: #fff;
  background: linear-gradient(110deg, #6749f0, #5136d9);
  border: 1px solid #6043e8;
  box-shadow: 0 4px 10px rgba(91, 63, 224, .15);
}
.primary-button:hover { background: linear-gradient(110deg, #5739df, #432ac3); box-shadow: 0 5px 14px rgba(91,63,224,.22); }
.subtle-button {
  color: #393364;
  background: #fff;
  border: 1px solid #e2def7;
}
.subtle-button:hover, .icon-button:hover { background: #f3f0ff; border-color: #d2c8ff; }
.text-button { min-height: 30px; padding: 0 5px; color: #6044e8; background: transparent; border: 0; }
.icon-button { min-width: 34px; min-height: 34px; padding: 0 8px; color: #51458b; background: #fbfaff; border: 1px solid #ebe8fa; }

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  width: 100%;
  margin-bottom: 14px;
}
.metric-card {
  position: relative;
  min-width: 0;
  min-height: 117px;
  padding: 16px 15px 14px;
  overflow: hidden;
  background: rgba(255,255,255,.96);
  border: 1px solid #e9e6f8;
  border-radius: 12px;
  box-shadow: var(--shadow);
}
.metric-top { display: flex; align-items: center; justify-content: space-between; gap: 7px; }
.metric-top > span { order: 2; flex: 1; color: #302b5b; font-size: 11px; font-weight: 700; line-height: 1.4; }
.metric-icon {
  display: grid;
  width: 39px;
  height: 39px;
  flex: 0 0 39px;
  order: 1;
  place-items: center;
  border-radius: 13px;
}
.metric-icon.violet { color: #6648ed; background: #eee9ff; }
.metric-icon.mint { color: #00a990; background: #d9f8f0; }
.metric-icon.rose { color: #f03f7d; background: #ffe4ed; }
.metric-icon.amber { color: #e9931f; background: #fff0d8; }
.metric-value {
  margin: -1px 0 4px 49px;
  color: #171440;
  font-family: 'Manrope', sans-serif;
  font-size: clamp(23px, 2vw, 29px);
  font-weight: 800;
  letter-spacing: -.9px;
  line-height: 1.05;
}
.metric-bottom { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 7px 0 0 49px; }
.metric-bottom > span:last-child { color: #8986a8; font-size: 9px; line-height: 1.4; }
.metric-change { display: inline-flex; align-items: center; gap: 2px; padding: 3px 5px; border-radius: 6px; font-size: 10px; font-weight: 700; }
.metric-change.positive { color: #059c86; background: #e1faf3; }
.metric-change.negative { color: #e9427a; background: #fff0f5; }

.main-charts {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(280px, 1fr);
  gap: 14px;
  margin-bottom: 14px;
}
.panel {
  min-width: 0;
  background: rgba(255,255,255,.97);
  border: 1px solid #e8e5f7;
  border-radius: 12px;
  box-shadow: var(--shadow);
}
.chart-panel { min-width: 0; padding: 17px 17px 13px; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
.panel-heading > div { min-width: 0; }
.panel-heading h2, .panel > h2 {
  margin: 0;
  color: #201b4b;
  font-family: 'Manrope', sans-serif;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: -.3px;
  line-height: 1.4;
}
.panel-heading p, .panel > p { margin: 3px 0 0; color: #8582a7; font-size: 10px; line-height: 1.5; }
.chart-legend { display: flex; align-items: center; gap: 14px; margin: 7px 0 2px; color: #827fa3; font-size: 10px; }
.chart-legend span, .legend-row > span { display: inline-flex; align-items: center; gap: 7px; }
.chart-legend i, .legend-row i { display: inline-block; width: 9px; height: 9px; flex: 0 0 9px; border-radius: 50%; }
.legend-violet { background: #6951ed; }
.legend-mint { background: #16b9a3; }
.chart-wrap { width: 100%; height: 210px; min-width: 0; min-height: 0; }
.chart-wrap .recharts-responsive-container { min-width: 0; }
.chart-wrap.large-chart { height: 290px; margin-top: 15px; }
.pie-wrap { position: relative; height: 190px; }
.donut-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  pointer-events: none;
}
.donut-center strong { color: #211b50; font-family: 'Manrope', sans-serif; font-size: 20px; font-weight: 800; }
.donut-center span { margin-top: 2px; color: #8985a8; font-size: 10px; }
.department-legend { display: grid; gap: 10px; margin: 0 2px 3px; }
.legend-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; color: #55517f; font-size: 11px; }
.legend-row > span { min-width: 0; }
.legend-row strong { color: #322d63; font-size: 11px; }

.employee-panel { padding: 14px 16px 0; overflow: hidden; }
.employee-heading { margin-bottom: 9px; }
.table-tools { display: flex; justify-content: flex-end; align-items: center; gap: 9px; margin: 0 0 10px; }
.search-box {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 225px;
  min-width: 0;
  height: 35px;
  padding: 0 10px;
  color: #7f7ba4;
  background: #fff;
  border: 1px solid #e6e2f8;
  border-radius: 10px;
}
.search-box input { font-size: 11px; }
.table-scroll { width: 100%; min-width: 0; overflow-x: auto; scrollbar-width: thin; scrollbar-color: #d6d0f4 transparent; }
.employee-table { width: 100%; min-width: 620px; border-collapse: separate; border-spacing: 0; text-align: left; }
.employee-table th {
  height: 30px;
  padding: 0 10px;
  color: #77749c;
  background: #f7f6fd;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .2px;
  white-space: nowrap;
}
.employee-table th:first-child { border-radius: 6px 0 0 6px; }
.employee-table th:last-child { border-radius: 0 6px 6px 0; }
.employee-table td { height: 40px; padding: 5px 10px; color: #77749c; border-bottom: 1px solid #efedf8; font-size: 10px; white-space: nowrap; }
.employee-table tbody tr:last-child td { border-bottom: 0; }
.employee-table tbody tr:hover { background: #fbfaff; }
.employee-identity { display: flex; align-items: center; gap: 9px; min-width: 155px; }
.employee-avatar {
  display: grid;
  width: 29px;
  height: 29px;
  flex: 0 0 29px;
  place-items: center;
  border-radius: 50%;
  font-size: 10px;
  font-weight: 800;
}
.employee-avatar.purple { color: #5c41d8; background: #e5dcff; }
.employee-avatar.blue { color: #2564cd; background: #dbe9ff; }
.employee-avatar.pink { color: #e74b83; background: #ffe0ea; }
.employee-avatar.orange { color: #b16b05; background: #ffebc8; }
.employee-avatar.green { color: #008b72; background: #d1f6e8; }
.employee-identity strong, .employee-identity small { display: block; }
.employee-identity strong { color: #28224f; font-size: 10px; font-weight: 700; }
.employee-identity small { margin-top: 2px; color: #8a87a8; font-size: 9px; }
.risk-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 7px; border-radius: 6px; font-size: 9px; font-weight: 700; }
.risk-badge i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
.risk-badge.low { color: #009d86; background: #def9f1; }
.risk-badge.medium { color: #bd790b; background: #fff0d4; }
.risk-badge.high { color: #e83e78; background: #ffe3ec; }
.score-cell { display: flex; align-items: center; gap: 8px; }
.score-track { width: 85px; height: 6px; overflow: hidden; background: #eeecf8; border-radius: 99px; }
.score-track span { display: block; height: 100%; border-radius: inherit; }
.score-track span.low { background: #12b69e; }
.score-track span.medium { background: #f5a12c; }
.score-track span.high { background: #fa4081; }
.score-cell strong { color: #4c477b; font-size: 9px; }
.active-status { display: inline-flex; align-items: center; gap: 6px; color: #079e89; font-size: 10px; }
.active-status i { width: 6px; height: 6px; border-radius: 50%; background: #12b89c; }
.table-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 34px; color: #8986a7; font-size: 9px; }
.table-footer button { display: inline-flex; align-items: center; gap: 4px; padding: 5px 0; color: #6246e9; background: transparent; border: 0; font-size: 10px; font-weight: 700; }
.empty-state { padding: 35px 15px; color: #8582a7; text-align: center; }

.dashboard-footnote {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  margin: 12px 2px 0;
  color: #8582a5;
  font-size: 10px;
  line-height: 1.6;
}
.dashboard-footnote svg { margin-top: 1px; }

.department-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.department-card { padding: 20px; }
.department-icon { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 13px; }
.department-label { display: block; margin-top: 17px; color: #8885a7; font-size: 10px; }
.department-card h2 { margin: 6px 0 15px; color: #25204f; font-size: 15px; line-height: 1.4; }
.department-total { color: #211b50; font-family: 'Manrope', sans-serif; font-size: 26px; font-weight: 800; }
.department-total span { color: #8885a7; font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 500; }
.progress-track { width: 100%; height: 6px; margin: 13px 0 8px; overflow: hidden; background: #f0eef9; border-radius: 99px; }
.progress-track span { display: block; height: 100%; border-radius: inherit; }
.department-card > small { color: #8582a7; font-size: 10px; }

.ai-page { display: grid; gap: 15px; }
.ai-hero {
  position: relative;
  overflow: hidden;
  padding: 27px;
  color: #fff;
  background: linear-gradient(115deg, #28205d, #5140b5 72%, #7056e8);
  border-color: transparent;
}
.ai-hero::after { position: absolute; top: -100px; right: -60px; width: 270px; height: 270px; content: ''; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; box-shadow: 0 0 0 30px rgba(255,255,255,.035), 0 0 0 60px rgba(255,255,255,.025); }
.ai-icon { display: grid; width: 48px; height: 48px; place-items: center; margin-bottom: 15px; color: white; background: rgba(255,255,255,.13); border-radius: 14px; }
.eyebrow { position: relative; z-index: 1; color: #d4caff; font-size: 10px; font-weight: 800; letter-spacing: 1px; }
.ai-hero h2 { position: relative; z-index: 1; max-width: 620px; margin: 8px 0; font-family: 'Manrope', sans-serif; font-size: clamp(22px, 2.6vw, 32px); line-height: 1.25; }
.ai-hero > p { position: relative; z-index: 1; max-width: 580px; color: #e1dcff; font-size: 12px; line-height: 1.8; }
.ai-stats { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 30px; margin-top: 25px; }
.ai-stats div { display: grid; gap: 5px; }
.ai-stats strong { font-family: 'Manrope', sans-serif; font-size: 23px; }
.ai-stats span { color: #d5ceff; font-size: 10px; }
.notice-box { display: flex; align-items: flex-start; gap: 10px; padding: 13px 15px; color: #77709f; background: #f4f1ff; border: 1px solid #e6e0ff; border-radius: 10px; font-size: 11px; line-height: 1.7; }
.notice-box svg { margin-top: 2px; color: #7156e8; }

.analytics-page { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(270px, 1fr); align-items: start; gap: 14px; }
.analytics-page .panel { padding: 19px; }
.analytics-page .legend-row { margin-top: 10px; }
.settings-panel { max-width: 850px; padding: 22px; }
.settings-panel > h2 { margin: 0; font-family: 'Manrope', sans-serif; font-size: 19px; }
.settings-panel > p { color: #8582a7; }
.settings-row { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 17px 0; border-bottom: 1px solid #efedf8; }
.settings-row strong, .settings-row small { display: block; }
.settings-row strong { color: #302b5c; font-size: 12px; }
.settings-row small { margin-top: 5px; color: #8582a7; font-size: 11px; line-height: 1.5; }
.settings-status { color: #009c86; font-size: 11px; font-weight: 700; }

.toast {
  position: fixed;
  top: 72px;
  right: 22px;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 10px;
  max-width: min(420px, calc(100vw - 30px));
  padding: 13px 15px;
  color: #fff;
  background: #25204f;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 11px;
  box-shadow: 0 10px 35px rgba(28, 22, 75, .2);
  font-size: 12px;
  line-height: 1.5;
}
.toast > svg { color: #5ce0bd; }
.toast button { display: grid; width: 26px; height: 26px; flex: 0 0 26px; place-items: center; margin-left: auto; color: white; background: transparent; border: 0; }
.modal-backdrop { position: fixed; inset: 0; z-index: 110; display: grid; place-items: center; padding: 18px; background: rgba(20, 16, 56, .48); backdrop-filter: blur(5px); }
.add-modal { width: min(100%, 450px); max-height: 90vh; overflow-y: auto; padding: 24px; background: white; border: 1px solid #e8e4fa; border-radius: 17px; box-shadow: 0 24px 80px rgba(22, 16, 69, .22); }
.modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 15px; margin-bottom: 20px; }
.modal-header h2 { margin: 0; color: #211b50; font-family: 'Manrope', sans-serif; font-size: 21px; }
.modal-header p { margin: 5px 0 0; color: #8582a7; font-size: 11px; }
.add-modal label { display: grid; gap: 7px; margin-bottom: 15px; color: #37315f; font-size: 11px; font-weight: 700; }
.add-modal input { width: 100%; min-height: 42px; padding: 0 12px; color: #27224f; background: #fff; border: 1px solid #e3e0f4; border-radius: 9px; }
.add-modal input:focus { border-color: #a99bff; outline: 0; box-shadow: 0 0 0 3px rgba(101, 71, 238, .09); }
.modal-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 20px; }
.modal-footnote { margin: 14px 0 0; color: #9290ad; font-size: 10px; line-height: 1.6; }

.app-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 40px;
  padding: 0 22px 13px;
  color: #9290ad;
  font-size: 10px;
}
.app-footer > span:last-child { display: inline-flex; align-items: center; gap: 6px; }
.app-footer i { width: 6px; height: 6px; background: #16b99d; border-radius: 50%; }
.app-footer b { color: #c1bdd9; }

.mobile-overlay { display: none; }

@media (min-width: 1600px) {
  .page-content { padding: 28px 30px 26px; }
  .metrics-grid, .main-charts { gap: 15px; }
  .metric-card { min-height: 120px; padding: 17px 18px; }
  .chart-panel { padding: 19px 20px 15px; }
  .chart-wrap { height: 225px; }
  .pie-wrap { height: 200px; }
}

@media (max-width: 1250px) {
  .page-content { padding: 21px 18px; }
  .topbar { padding-right: 19px; padding-left: 19px; }
  .metric-card { padding: 14px 12px; }
  .metric-icon { width: 35px; height: 35px; flex-basis: 35px; }
  .metric-value, .metric-bottom { margin-left: 43px; }
  .metric-bottom > span:last-child { font-size: 9px; }
  .main-charts { grid-template-columns: minmax(0, 1.35fr) minmax(255px, 1fr); }
  .chart-panel { padding: 15px 13px 12px; }
  .heading-actions { gap: 7px; }
  .heading-actions .primary-button, .heading-actions .subtle-button { padding: 0 9px; }
  .department-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 1000px) {
  .sidebar { width: 225px; min-width: 225px; }
  .main-area { width: calc(100% - 225px); margin-left: 225px; }
  .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .main-charts, .analytics-page { grid-template-columns: minmax(0, 1fr); }
  .department-chart { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; column-gap: 15px; }
  .department-chart .panel-heading { grid-column: 1 / -1; }
  .department-chart .chart-wrap { grid-row: span 1; }
  .department-legend { align-content: center; }
  .top-search { width: clamp(130px, 18vw, 220px); }
  .topbar-right { gap: 10px; }
}

@media (max-width: 760px) {
  .sidebar { width: 260px; min-width: 260px; max-width: 85vw; transform: translateX(-105%); transition: transform .25s ease; }
  .sidebar.sidebar-open { transform: translateX(0); }
  .mobile-overlay { position: fixed; inset: 0; z-index: 45; display: block; background: rgba(18, 14, 50, .43); border: 0; }
  .mobile-close { display: grid; width: 29px; height: 29px; flex: 0 0 29px; place-items: center; margin-left: auto; color: white; background: rgba(255,255,255,.09); border: 0; border-radius: 7px; }
  .main-area { width: 100%; margin-left: 0; }
  .mobile-menu-button { display: grid; }
  .topbar { height: 56px; gap: 8px; padding: 0 14px; }
  .topbar-left { gap: 8px; }
  .topbar-right { gap: 8px; }
  .top-search { width: clamp(100px, 27vw, 190px); height: 34px; }
  .top-profile > div:nth-child(2), .top-profile > svg, .topbar-divider { display: none; }
  .top-profile .profile-avatar { width: 31px; height: 31px; flex-basis: 31px; }
  .page-content { padding: 20px 15px 22px; }
  .page-heading { align-items: flex-start; flex-direction: column; gap: 13px; }
  .heading-actions { width: 100%; justify-content: flex-start; }
  .main-charts { grid-template-columns: minmax(0, 1fr); }
  .chart-wrap { height: 205px; }
  .chart-wrap.large-chart { height: 260px; }
  .department-chart { display: block; }
  .department-chart .chart-wrap { height: 190px; }
  .department-legend { gap: 9px; }
  .employee-panel { padding: 13px 12px 0; }
  .employee-heading { align-items: flex-start; }
  .table-tools { justify-content: stretch; }
  .table-tools .search-box { flex: 1; width: auto; }
  .department-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .department-card { padding: 15px; }
  .department-card h2 { font-size: 13px; overflow-wrap: anywhere; }
  .app-footer { padding: 0 15px 15px; flex-wrap: wrap; }
}

@media (max-width: 480px) {
  .breadcrumbs { font-size: 10px; }
  .breadcrumbs span { padding: 0 4px; }
  .top-search { width: 35px; padding: 0 9px; border: 0; background: transparent; }
  .top-search input { width: 0; min-width: 0; padding: 0; opacity: 0; }
  .top-search:focus-within { position: absolute; left: 60px; right: 112px; z-index: 5; width: auto; padding: 0 10px; background: #fff; border: 1px solid #e4e1f7; }
  .top-search:focus-within input { width: 100%; opacity: 1; }
  .page-heading h1 { font-size: 24px; }
  .heading-actions .primary-button, .heading-actions .subtle-button { min-height: 34px; font-size: 10px; }
  .metrics-grid { gap: 9px; }
  .metric-card { min-height: 112px; padding: 11px 9px; }
  .metric-top { align-items: flex-start; flex-direction: column; gap: 6px; }
  .metric-top > span { order: 1; font-size: 10px; }
  .metric-icon { order: 0; width: 30px; height: 30px; flex-basis: 30px; border-radius: 9px; }
  .metric-icon svg { width: 16px; height: 16px; }
  .metric-value { margin: 7px 0 0; font-size: 24px; }
  .metric-bottom { margin: 5px 0 0; gap: 4px; }
  .metric-change { font-size: 9px; }
  .metric-bottom > span:last-child { font-size: 8px; }
  .chart-panel { padding: 13px 10px; }
  .panel-heading h2 { font-size: 14px; }
  .chart-wrap { height: 180px; }
  .chart-wrap.large-chart { height: 220px; }
  .department-grid { grid-template-columns: minmax(0, 1fr); }
  .employee-heading { flex-direction: column; }
  .employee-heading .text-button { align-self: flex-start; }
  .table-footer { align-items: flex-start; padding: 7px 0; }
  .table-footer button { white-space: nowrap; }
  .ai-hero { padding: 20px; }
  .ai-stats { gap: 18px; }
  .settings-row { align-items: flex-start; flex-direction: column; }
  .app-footer { font-size: 9px; }
}

/* ==========================================
   WorkForce AI Pro - Authentication Screens
   ========================================== */

.auth-screen {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(420px, 0.9fr);
  min-height: 100vh;
  background: #fff;
}

.auth-brand-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  padding: clamp(28px, 5vw, 70px);
  overflow: hidden;
  color: #fff;
  background:
    radial-gradient(circle at 90% 15%, rgba(139, 113, 255, .35), transparent 30%),
    linear-gradient(145deg, #17143e 0%, #27205f 55%, #4932b4 100%);
}

.auth-brand {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12px;
}

.auth-brand > div:last-child strong,
.auth-mobile-brand > strong {
  display: block;
  font-family: 'Manrope', sans-serif;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -.7px;
}

.auth-brand strong span,
.auth-mobile-brand strong span {
  color: #a995ff;
}

.auth-brand > div:last-child small {
  display: block;
  margin-top: 4px;
  color: #c2b9f5;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.auth-brand-content {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 570px;
  margin: 55px 0;
}

.auth-brand-content > .eyebrow {
  display: inline-block;
  margin-bottom: 17px;
}

.auth-brand-content h1 {
  max-width: 560px;
  margin: 0 0 18px;
  font-family: 'Manrope', sans-serif;
  font-size: clamp(32px, 4vw, 51px);
  font-weight: 800;
  line-height: 1.18;
  letter-spacing: -1.8px;
}

.auth-brand-content > p {
  max-width: 500px;
  margin: 0 0 32px;
  color: #d5d0f5;
  font-size: 14px;
  line-height: 1.9;
}

.auth-feature {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-top: 18px;
}

.auth-feature > span {
  display: grid;
  width: 43px;
  height: 43px;
  flex: 0 0 43px;
  place-items: center;
  color: #dcd4ff;
  background: rgba(255, 255, 255, .09);
  border: 1px solid rgba(255, 255, 255, .12);
  border-radius: 12px;
}

.auth-feature strong,
.auth-feature small {
  display: block;
}

.auth-feature strong {
  color: #fff;
  font-size: 13px;
  font-weight: 700;
}

.auth-feature small {
  margin-top: 5px;
  color: #c2bce8;
  font-size: 11px;
  line-height: 1.5;
}

.auth-brand-footer {
  position: relative;
  z-index: 1;
  color: #bcb5e8;
  font-size: 10px;
}

.auth-form-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: clamp(24px, 5vw, 65px);
  background:
    radial-gradient(ellipse at 90% 0%, rgba(213, 205, 255, .25), transparent 38%),
    #fff;
}

.auth-form-card {
  width: 100%;
  max-width: 430px;
}

.auth-mobile-brand {
  display: none;
  align-items: center;
  gap: 10px;
  margin-bottom: 34px;
}

.auth-form-heading {
  margin-bottom: 23px;
}

.auth-form-heading .greeting {
  margin-bottom: 13px;
  line-height: 1.6;
}

.auth-form-heading h2 {
  margin: 0;
  color: #201b4b;
  font-family: 'Manrope', sans-serif;
  font-size: clamp(27px, 3vw, 34px);
  font-weight: 800;
  letter-spacing: -1px;
  line-height: 1.3;
}

.auth-form-heading > p {
  margin: 9px 0 0;
  color: #8582a7;
  font-size: 12px;
  line-height: 1.7;
}

.backend-status {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 22px;
  padding: 10px 12px;
  color: #77749a;
  background: #f8f7ff;
  border: 1px solid #eeebfb;
  border-radius: 9px;
  font-size: 10px;
}

.backend-status i {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  background: #aaa5c4;
  border-radius: 50%;
}

.backend-status.online i {
  background: #10b99a;
  box-shadow: 0 0 0 3px rgba(16, 185, 154, .12);
}

.backend-status.offline i {
  background: #ef477d;
  box-shadow: 0 0 0 3px rgba(239, 71, 125, .1);
}

.auth-error {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  margin-bottom: 17px;
  padding: 12px;
  color: #bd2859;
  background: #fff0f5;
  border: 1px solid #ffd6e3;
  border-radius: 9px;
  font-size: 11px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.auth-error svg {
  flex: 0 0 auto;
  margin-top: 1px;
}

.auth-label {
  display: grid;
  gap: 8px;
  margin-bottom: 19px;
  color: #37315f;
  font-size: 11px;
  font-weight: 700;
}

.auth-label > input,
.password-field {
  width: 100%;
  min-height: 45px;
  color: #27224f;
  background: #fff;
  border: 1px solid #e3e0f4;
  border-radius: 10px;
  transition: border-color .2s, box-shadow .2s;
}

.auth-label > input {
  padding: 0 13px;
}

.auth-label > input::placeholder,
.password-field input::placeholder {
  color: #aaa6c2;
  font-weight: 400;
}

.auth-label > input:focus,
.password-field:focus-within {
  border-color: #a99bff;
  outline: none;
  box-shadow: 0 0 0 3px rgba(101, 71, 238, .09);
}

.password-field {
  display: flex;
  align-items: center;
  padding-right: 6px;
}

.password-field input {
  width: 100%;
  min-width: 0;
  min-height: 42px;
  padding: 0 12px;
  color: #27224f;
  background: transparent;
  border: 0;
  outline: 0;
}

.password-field button {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  place-items: center;
  color: #817ca5;
  background: transparent;
  border: 0;
  border-radius: 7px;
}

.password-field button:hover {
  color: #5c43e8;
  background: #f5f2ff;
}

.field-hint {
  color: #9290ad;
  font-size: 10px;
  font-weight: 400;
}

.auth-submit {
  width: 100%;
  min-height: 45px;
  margin-top: 5px;
  font-size: 12px;
}

.auth-submit:disabled {
  cursor: wait;
  opacity: .7;
}

.spin-icon {
  animation: workforce-spin 1s linear infinite;
}

@keyframes workforce-spin {
  to { transform: rotate(360deg); }
}

.auth-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 23px;
  color: #8582a7;
  font-size: 11px;
  text-align: center;
}

.auth-switch button {
  padding: 3px;
  color: #5c43e8;
  background: transparent;
  border: 0;
  font-size: 11px;
  font-weight: 800;
}

.auth-switch button:hover {
  color: #4530c4;
  text-decoration: underline;
}

.auth-register-note {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 20px;
  padding: 12px;
  color: #77709f;
  background: #f7f5ff;
  border: 1px solid #ebe6ff;
  border-radius: 9px;
  font-size: 10px;
  line-height: 1.7;
}

.auth-register-note svg {
  flex: 0 0 auto;
  margin-top: 1px;
  color: #765ce8;
}

.auth-security-note {
  margin: 27px 0 0;
  color: #a09cb8;
  font-size: 10px;
  line-height: 1.7;
  text-align: center;
}

@media (max-width: 900px) {
  .auth-screen {
    grid-template-columns: minmax(0, .85fr) minmax(380px, 1fr);
  }

  .auth-brand-panel {
    padding: 30px;
  }

  .auth-form-panel {
    padding: 30px;
  }

  .auth-brand-content h1 {
    font-size: clamp(29px, 4vw, 39px);
  }
}

@media (max-width: 680px) {
  .auth-screen {
    display: block;
    min-height: 100vh;
    background: #fff;
  }

  .auth-brand-panel {
    display: none;
  }

  .auth-form-panel {
    align-items: flex-start;
    min-height: 100vh;
    padding: 35px 22px;
  }

  .auth-form-card {
    max-width: 430px;
    margin: 0 auto;
  }

  .auth-mobile-brand {
    display: flex;
  }

  .auth-mobile-brand .brand-mark {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
  }

  .auth-mobile-brand > strong {
    color: #201b4b;
    font-size: 20px;
  }

  .auth-form-heading h2 {
    font-size: 29px;
  }
}

@media (max-width: 380px) {
  .auth-form-panel {
    padding: 26px 16px;
  }

  .auth-form-heading h2 {
    font-size: 26px;
  }
}

/* Department form responsive styling */
.department-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10px;
}

.department-form {
  grid-column: 1 / -1;
  padding: 26px;
  border: 1px solid #e9e5fb;
  border-radius: 18px;
  background: linear-gradient(145deg, #ffffff, #fbfaff);
  box-shadow: 0 8px 28px rgba(74, 56, 140, 0.06);
}

.department-form .panel-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
}

.department-form .panel-heading h2 {
  margin: 0 0 7px;
  color: #28234a;
  font-size: 20px;
  font-weight: 700;
}

.department-form .panel-heading p {
  margin: 0;
  color: #88839f;
  font-size: 13px;
  line-height: 1.6;
}

.department-form .panel-heading > svg {
  flex-shrink: 0;
  color: #765ce8;
}

.department-form-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.department-form-fields .auth-label {
  display: flex;
  flex-direction: column;
  gap: 9px;
  color: #46415f;
  font-size: 13px;
  font-weight: 600;
}

.department-form-fields .auth-label > span {
  color: #e35f7b;
}

.department-form-fields .auth-input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 45px;
  padding: 12px 14px;
  border: 1px solid #e4e0f0;
  border-radius: 10px;
  outline: none;
  background: #fff;
  color: #302b4d;
  font-family: inherit;
  font-size: 13px;
  font-weight: 400;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.department-form-fields .auth-input::placeholder {
  color: #aaa5bd;
}

.department-form-fields .auth-input:focus {
  border-color: #8a74ed;
  box-shadow: 0 0 0 3px rgba(118, 92, 232, 0.11);
}

.department-form-fields .auth-input:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.department-form-fields .department-description-input {
  min-height: 100px;
  resize: vertical;
  line-height: 1.6;
}

.department-form-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid #efedf7;
}

.department-form-actions button,
.department-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.department-form-actions button:disabled,
.department-actions button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

@media (max-width: 680px) {
  .department-form {
    padding: 19px;
    border-radius: 14px;
  }

  .department-form-fields {
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }

  .department-page-heading {
    align-items: flex-start;
    gap: 14px;
  }

  .department-actions {
    width: 100%;
    justify-content: flex-start;
  }

  .department-form-actions {
    justify-content: stretch;
  }

  .department-form-actions button {
    flex: 1;
  }
}

@media (max-width: 380px) {
  .department-form {
    padding: 15px;
  }

  .department-form-actions {
    flex-direction: column-reverse;
    align-items: stretch;
  }

  .department-form-actions button {
    width: 100%;
  }
}

/* Department card action buttons */
.department-card-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid #efedf7;
}

.department-card-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 38px;
  padding: 9px 14px;
  border-radius: 9px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.department-card-actions button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.department-card-actions button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.department-card-actions .subtle-button {
  border: 1px solid #e4defa;
  background: #f7f4ff;
  color: #7057d9;
}

.department-card-actions .subtle-button:hover:not(:disabled) {
  border-color: #c9bcfa;
  background: #eee8ff;
}

.department-deactivate-button {
  border: 1px solid #f3d8dc;
  background: #fff6f7;
  color: #c34d60;
}

.department-deactivate-button:hover:not(:disabled) {
  border-color: #eab5be;
  background: #ffebee;
}

@media (max-width: 480px) {
  .department-card-actions {
    gap: 8px;
  }

  .department-card-actions button {
    flex: 1;
    padding: 9px 10px;
  }
}
